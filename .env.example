# ==============================================================================
# ENDEVIS InvoiceFlow — Environment Variables
# Copy to .env.local and fill in. Local Supabase values are populated
# automatically by `supabase start` (see AGENTS.md).
# ==============================================================================

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — NEVER expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ENDEVIS InvoiceFlow"

# --- AI (OpenAI Responses API + Vision OCR) — optional in dev ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email (Resend) — optional in dev ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="ENDEVIS InvoiceFlow <invoices@example.com>"

# --- WhatsApp Business API — optional in dev ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
